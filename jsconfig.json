{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // This maps "@/..." aliases to the root directory
      "@/*": ["*"],
      
      // We explicitly map the common folders too for robustness
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/models/*": ["models/*"]
    }
  },
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}