{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // This is the core fix for the alias: it maps @/ to the project root
      "@/*": ["*"], 
      // Explicitly map lib and models for robustness
      "@/lib/*": ["lib/*"],
      "@/models/*": ["models/*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx"]
}