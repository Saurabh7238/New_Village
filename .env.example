# Your MongoDB Connection String (Accurate for Atlas and Vercel)
# Replace YOUR_PASSWORD with your actual MongoDB Atlas password
MONGODB_URI=mongodb+srv://nextjs_user:YOUR_PASSWORD@cluster0.0bcko3e.mongodb.net/test?retryWrites=true&w=majority&appName=Cluster0
# NextAuth Secret (MUST match Vercel setting)
NEXTAUTH_SECRET=affd854feb7001f8e6fd0c0ab43c3b5f85ed1c52f66e38dbcfd945ceeafdabbd

# 🚨 CHANGE THIS FOR LOCALHOST DEVELOPMENT
NEXTAUTH_URL=http://localhost:3000

# Fast2SMS — free ₹50 credits on signup (https://www.fast2sms.com)
# Dev API → copy Authorization Key from dashboard
FAST2SMS_API_KEY=your_fast2sms_authorization_key
# Route: "q" = Quick SMS (works without OTP website verification)
# Route: "otp" = OTP route (requires website verification in Fast2SMS panel)
FAST2SMS_ROUTE=q
